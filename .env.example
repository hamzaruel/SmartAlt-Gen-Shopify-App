# Shopify app credentials (from your Partner dashboard)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_HANDLE=
SHOPIFY_HOST=
SHOPIFY_SCOPES=read_products,write_products,read_files,write_files,read_content,write_content

# Public (client-side App Bridge) — must equal SHOPIFY_API_KEY
NEXT_PUBLIC_SHOPIFY_API_KEY=

# App URLs
APP_BASE_URL=
NEXT_PUBLIC_APP_URL=

# Turso (libsql) — stores ONLY shop access tokens
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Gemini (AI alt-text vision) — optional; template mode works without it
GEMINI_API_KEY=
